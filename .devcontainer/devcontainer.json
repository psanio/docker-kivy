{
  "name": "kivy-android-4.1",
  "image": "thewtex/opengl:ubuntu1804",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "root",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "echo 'Codespace base image ready'",
  "forwardPorts": [],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached"
  ]
}
