{
  "name": "kivy-android-4.1",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "remoteUser": "builder",
  "workspaceFolder": "/home/builder/app",
  "postCreateCommand": "echo 'Container ready'; true",
  "forwardPorts": [],
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/builder/app,type=bind,consistency=cached"
  ]
}
